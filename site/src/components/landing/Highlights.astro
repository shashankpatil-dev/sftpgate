---
import { about, highlights } from '../../data/landing.mjs';
---

<section class="highlights">
	<div class="wrap about">
		<h2>{about.title}</h2>
		<p>{about.text}</p>
	</div>
	<ul class="wrap">
		{
			highlights.map((item) => (
				<li>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.highlights {
		padding-block: clamp(2.5rem, 5vw, 3.5rem);
		border-bottom: 1px solid var(--gate-line);
	}

	ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3.5rem);
		padding: 0;
		list-style: none;
	}

	.about {
		margin-bottom: 2.25rem;
	}

	.about h2 {
		margin: 0 0 0.6rem;
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
		line-height: 1.12;
		letter-spacing: -0.02em;
	}

	.about p {
		max-width: 62ch;
		font-size: 1.1rem;
	}

	h3 {
		margin: 0 0 0.35rem;
		font-size: 1.1rem;
	}

	p {
		margin: 0;
		color: var(--gate-muted);
		font-size: 0.98rem;
	}

	@media (max-width: 44rem) {
		ul {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
