        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Files moved by transfers",
      "description": "skipped: the file was already there, so it was not moved again.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
