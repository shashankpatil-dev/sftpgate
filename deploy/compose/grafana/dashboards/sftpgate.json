          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(sftpgate_config_reload_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Post-upload actions per minute",
      "description": "Each PGP, copy and webhook step. step=queue counts files handed to the queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (step, result) (rate(sftpgate_actions_total{step!=\"job\"}[5m])) * 60",
          "legendFormat": "{{step}} {{result}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Post-upload queue",
      "description": "pending: waiting to run or to retry. failed: gave up after max_attempts; their files are in queue/failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
