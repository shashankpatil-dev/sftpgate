        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (storage) (increase(sftpgate_storage_errors_total[5m]))",
          "legendFormat": "{{storage}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Denied operations",
      "description": "Requests refused by folder permissions or patterns. Often a partner using the wrong folder.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (account, folder, op) (increase(sftpgate_operations_total{result=\"denied\",account=~\"$account\"}[5m]))",
          "legendFormat": "{{account}} {{folder}} {{op}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Config reloads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
